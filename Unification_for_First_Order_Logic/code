def occurs_check(var, expr):
    if var == expr:
        return True
    if isinstance(expr, tuple):
        return any(occurs_check(var, arg) for arg in expr[1])
    return False


def apply_substitution(expr, subst):
    if isinstance(expr, str):
        while expr in subst:
            expr = subst[expr]
        return expr

    if isinstance(expr, tuple):
        predicate, args = expr
        return (predicate, tuple(
            apply_substitution(arg, subst) for arg in args
        ))

    return expr


def unify(T1, T2):
    if T1 == T2:
        return {}

    if isinstance(T1, str) and T1.islower():
        if occurs_check(T1, T2):
            return None
        return {T1: T2}

    if isinstance(T2, str) and T2.islower():
        if occurs_check(T2, T1):
            return None
        return {T2: T1}

    if isinstance(T1, str) or isinstance(T2, str):
        return None

    if T1[0] != T2[0]:
        return None

    if len(T1[1]) != len(T2[1]):
        return None

    subst = {}

    for a, b in zip(T1[1], T2[1]):

        a = apply_substitution(a, subst)
        b = apply_substitution(b, subst)

        s = unify(a, b)

        if s is None:
            return None

        for key in subst:
            subst[key] = apply_substitution(subst[key], s)

        subst.update(s)

    return subst

T1 = ("Eats", ("x", "Apple"))
T2 = ("Eats", ("Riya", "y"))

result = unify(T1, T2)

if result is None:
    print("Unification Failed")
else:
    print("Unification Successful")
    print("Substitution:", result)
    print("Unified Expression:", apply_substitution(T1, result))
