def display_board(grid):
  print("\n" + "="*11)
  for i in range(9):
    print(f" {grid[i] if grid[i] != 0 else ' '} ", end="")
    if (i + 1) % 3 == 0:
      print("")
      if i < 8:
        print("---+---+---")
    elif i < 8:
      print("|", end="")
  print("="*11 + "\n")

def placex(grid):
  free_positions = []
  for i, val in enumerate(grid):
    if val == 0:
      free_positions.append(i)
  if not free_positions:
    return False

  print("Possible positions for X:", free_positions)
  while True:
    try:
      x = int(input("Enter where to place X (0-8): "))
      if x in free_positions:
        grid[x] = "X"
        return True
      else:
        print("Invalid position. Please choose an empty spot from:", free_positions)
    except ValueError:
      print("Invalid input. Please enter a number.")

def placey(grid):
  free_positions = []
  for i, val in enumerate(grid):
    if val == 0:
      free_positions.append(i)
  if free_positions:
    grid[free_positions[0]] = "O"
    print(f"Player O placed at position {free_positions[0]}")
    return True
  return False

def checkwin(grid):
  wins = [
      [0, 1, 2], [3, 4, 5], [6, 7, 8],
      [0, 3, 6], [1, 4, 7], [2, 5, 8],
      [0, 4, 8], [2, 4, 6]
  ]

  for combo in wins:
    if grid[combo[0]] == grid[combo[1]] == grid[combo[2]] and grid[combo[0]] != 0:
      return grid[combo[0]]
  return None

def is_board_full(grid):
  return all(cell != 0 for cell in grid)

current_grid = ["O", 0, "X", "X", 0, 0, "X", "O", "O"]
current_player = "X"

print("\n--- Tic-Tac-Toe Game Start ---")
display_board(current_grid)

while True:
  winner = checkwin(current_grid)
  if winner:
    print(f"!!! Player {winner} wins! !!!")
    break
  if is_board_full(current_grid):
    print("!!! It's a draw! !!!")
    break

  if current_player == "X":
    print(f"\nPlayer {current_player}'s turn.")
    if placex(current_grid):
      current_player = "O"
    else:
      print("No valid moves for X or error in placement. Trying again.")
  else:
    print(f"\nPlayer {current_player}'s turn.")
    if placey(current_grid):
      current_player = "X"
    else:
      print("No valid moves for O. Trying again.")

  display_board(current_grid)
