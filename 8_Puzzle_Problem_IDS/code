def dls(state, goal, depth, visited):
    if state == goal:
        return [state]

    if depth == 0:
        return None

    zero = state.index(0)
    row, col = divmod(zero, 3)

    moves = []
    if row > 0:
        moves.append(zero - 3)  # Up
    if row < 2:
        moves.append(zero + 3)  # Down
    if col > 0:
        moves.append(zero - 1)  # Left
    if col < 2:
        moves.append(zero + 1)  # Right

    for move in moves:
        new_state = list(state)
        new_state[zero], new_state[move] = (
            new_state[move], new_state[zero]
        )
        new_state = tuple(new_state)

        if new_state not in visited:
            visited.add(new_state)
            path = dls(new_state, goal, depth - 1, visited)

            if path:
                return [state] + path

            visited.remove(new_state)

    return None


def ids(start, goal, max_depth=50):
    for depth in range(max_depth + 1):
        visited = {start}
        path = dls(start, goal, depth, visited)

        if path:
            return path

    return None


start = (5, 4, 6,
         1, 8, 7,
         3, 2, 0)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

path = ids(start, goal)

if path:
    print("Solution found using IDS:")
    print("Number of moves:", len(path) - 1)

    for state in path:
        for i in range(0, 9, 3):
            print(state[i:i+3])
        print()
else:
    print("No solution found within maximum depth.")
